<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>La Copa Odiosa - Draft 5-a-3 (Versión Dibujos)</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Montserrat', sans-serif;
      background-color: #090305;
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(185, 28, 28, 0.28) 0%, transparent 60%),
        radial-gradient(circle at 15% 85%, rgba(127, 29, 29, 0.2) 0%, transparent 50%),
        radial-gradient(circle at 85% 85%, rgba(217, 119, 6, 0.15) 0%, transparent 50%);
      color: #f8fafc;
      min-height: 100vh;
      overflow-x: hidden;
    }

    .font-epic {
      font-family: 'Cinzel', serif;
    }

    /* Animaciones de Pick y Ban */
    @keyframes banSlam {
      0% { transform: scale(1.35) rotate(-6deg); filter: brightness(2) contrast(1.5); }
      50% { transform: scale(0.95) rotate(3deg); }
      100% { transform: scale(1) rotate(0deg); }
    }

    @keyframes pickGlow {
      0% { transform: scale(0.92); box-shadow: 0 0 0 rgba(234, 179, 8, 0); }
      50% { transform: scale(1.06); box-shadow: 0 0 30px rgba(234, 179, 8, 0.85); }
      100% { transform: scale(1.02); box-shadow: 0 0 18px rgba(234, 179, 8, 0.5); }
    }

    @keyframes pulseBorder {
      0%, 100% { border-color: rgba(239, 68, 68, 0.5); box-shadow: 0 0 15px rgba(239, 68, 68, 0.2); }
      50% { border-color: rgba(251, 191, 36, 0.9); box-shadow: 0 0 25px rgba(251, 191, 36, 0.45); }
    }

    .card-banned {
      animation: banSlam 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .card-banned .avatar-container {
      filter: grayscale(100%) brightness(0.45) contrast(1.2);
    }

    .card-picked {
      animation: pickGlow 0.5s ease-out forwards;
      border-color: #f59e0b !important;
      background: linear-gradient(145deg, rgba(120, 53, 15, 0.45), rgba(24, 24, 27, 0.9)) !important;
    }

    .target-active {
      animation: pulseBorder 1.5s infinite;
      cursor: pointer;
    }

    .target-active:hover {
      transform: translateY(-4px) scale(1.03);
    }

    /* Cadenas cruzadas para el Ban */
    .ban-chains {
      background-image: 
        repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(153, 27, 27, 0.85) 10px, rgba(153, 27, 27, 0.85) 14px, rgba(24, 24, 27, 0.95) 14px, rgba(24, 24, 27, 0.95) 18px),
        repeating-linear-gradient(-45deg, transparent, transparent 10px, rgba(185, 28, 28, 0.85) 10px, rgba(185, 28, 28, 0.85) 14px, rgba(24, 24, 27, 0.95) 14px, rgba(24, 24, 27, 0.95) 18px);
    }

    /* Scrollbar estilizada */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #0f0507; }
    ::-webkit-scrollbar-thumb { background: #7f1d1d; border-radius: 3px; }
  </style>
</head>
<body class="flex flex-col justify-between">

  <!-- HEADER PRINCIPAL -->
  <header class="border-b border-red-900/50 bg-black/70 backdrop-blur-md sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-red-700 to-amber-600 flex items-center justify-center shadow-lg shadow-red-900/40 border border-amber-400/40">
          <span class="font-epic font-black text-xl text-white">⚔️</span>
        </div>
        <div>
          <h1 class="font-epic font-black text-xl md:text-2xl tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-red-400 to-amber-200">
            LA COPA ODIOSA • DRAFT 5-A-3
          </h1>
          <p class="text-xs text-stone-400 font-semibold tracking-widest uppercase">
            Aermyfus Retro 1.29 • Nivel 160 Estricto • BO1
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <a href="index.html" class="px-3 py-1.5 rounded-lg bg-amber-950/60 hover:bg-amber-900/70 border border-amber-600/40 text-xs font-bold text-amber-200 transition">
          🎭 Ver Caras Clásicas
        </a>
        <button id="soundToggleBtn" onclick="toggleSound()" class="px-3 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 border border-stone-700 text-xs font-semibold text-stone-300 flex items-center gap-1.5 transition">
          <span id="soundIcon">🔊</span> <span id="soundText">Sonido ON</span>
        </button>
        <button onclick="resetAll()" class="px-3 py-1.5 rounded-lg bg-red-950/70 hover:bg-red-900/80 border border-red-700/50 text-xs font-bold text-red-200 transition">
          ↺ Nuevo Combate
        </button>
      </div>
    </div>
  </header>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="max-w-7xl w-full mx-auto px-4 py-6 flex-grow">

    <!-- FASE 1: CONFIGURACIÓN DE EQUIPOS Y POOLS DE 5 -->
    <section id="setupSection" class="space-y-6">
      <div class="bg-stone-950/80 border border-red-900/40 rounded-2xl p-5 shadow-2xl">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-stone-800 pb-4 mb-5">
          <div>
            <h2 class="font-epic text-lg font-bold text-amber-400">1. Inscripción de Pools Cerrados (5 Clases Únicas por Equipo)</h2>
            <p class="text-xs text-stone-400 mt-0.5">Selecciona 5 clases distintas para cada equipo. Se permiten mirror matches entre equipos rivales.</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <button onclick="randomizePools()" class="px-3 py-2 rounded-lg bg-stone-800 hover:bg-stone-700 border border-stone-600 text-xs font-bold text-stone-200 transition">
              🎲 Aleatorio (Prueba rápida)
            </button>
            <button id="startDraftBtn" onclick="startDraft()" disabled class="px-5 py-2 rounded-lg bg-gradient-to-r from-red-700 to-amber-600 disabled:opacity-40 disabled:cursor-not-allowed hover:from-red-600 hover:to-amber-500 text-xs md:text-sm font-extrabold text-white shadow-lg shadow-red-900/50 transition uppercase tracking-wider">
              🔥 Iniciar Arena de Draft →
            </button>
          </div>
        </div>

        <!-- Nombres y Selección de Pools -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- EQUIPO A -->
          <div class="bg-gradient-to-b from-red-950/30 to-stone-950 border border-red-800/40 rounded-xl p-4">
            <div class="flex items-center justify-between gap-3 mb-3">
              <div class="flex items-center gap-2 flex-grow">
                <span class="px-2.5 py-1 rounded bg-red-700 text-white font-black text-xs">EQUIPO A</span>
                <input id="teamANameInput" type="text" value="Los Herederos de Odiosa" placeholder="Nombre Equipo A" class="bg-black/60 border border-red-900/50 rounded-lg px-3 py-1.5 text-sm font-bold text-white w-full focus:outline-none focus:border-amber-400">
              </div>
              <span id="teamACount" class="text-xs font-extrabold px-2.5 py-1 rounded-full bg-stone-900 text-amber-400 border border-amber-500/30">0 / 5</span>
            </div>
            <div id="teamASelectorGrid" class="grid grid-cols-3 sm:grid-cols-4 gap-2"></div>
          </div>

          <!-- EQUIPO B -->
          <div class="bg-gradient-to-b from-amber-950/25 to-stone-950 border border-amber-700/40 rounded-xl p-4">
            <div class="flex items-center justify-between gap-3 mb-3">
              <div class="flex items-center gap-2 flex-grow">
                <span class="px-2.5 py-1 rounded bg-amber-600 text-black font-black text-xs">EQUIPO B</span>
                <input id="teamBNameInput" type="text" value="La Guardia del Jurista" placeholder="Nombre Equipo B" class="bg-black/60 border border-amber-800/50 rounded-lg px-3 py-1.5 text-sm font-bold text-white w-full focus:outline-none focus:border-amber-400">
              </div>
              <span id="teamBCount" class="text-xs font-extrabold px-2.5 py-1 rounded-full bg-stone-900 text-amber-400 border border-amber-500/30">0 / 5</span>
            </div>
            <div id="teamBSelectorGrid" class="grid grid-cols-3 sm:grid-cols-4 gap-2"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- FASE 2: ARENA DE DRAFT EN VIVO (LOS 7 TURNOS) -->
    <section id="draftArenaSection" class="hidden space-y-5">

      <!-- BARRA DE ESTADO DEL TURNO ACTUAL -->
      <div id="turnBanner" class="relative overflow-hidden rounded-2xl border-2 border-amber-500/60 bg-gradient-to-r from-red-950 via-stone-900 to-amber-950 p-4 shadow-2xl">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <div id="turnBadge" class="px-4 py-2 rounded-xl bg-red-600 text-white font-epic font-black text-base md:text-lg shadow-lg whitespace-nowrap">
              TURNO 1 / 7
            </div>
            <div>
              <h2 id="turnTitle" class="font-epic font-black text-lg md:text-2xl text-amber-300 tracking-wide">
                EQUIPO A — PICK 1
              </h2>
              <p id="turnInstruction" class="text-xs md:text-sm text-stone-200 font-medium">
                Elige 1 clase de tu propio pool para asegurarla en combate.
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <button onclick="backToSetup()" class="px-3 py-1.5 rounded-lg bg-stone-900/90 hover:bg-stone-800 border border-stone-700 text-xs font-semibold text-stone-300">
              ← Editar Pools
            </button>
          </div>
        </div>

        <!-- Línea de progreso de los 7 turnos -->
        <div id="timelineSteps" class="grid grid-cols-7 gap-1.5 mt-4 pt-3 border-t border-white/10"></div>
      </div>

      <!-- TABLERO ENFRENTADO: EQUIPO A VS EQUIPO B -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

        <!-- COLUMNA EQUIPO A (5 cols) -->
        <div class="lg:col-span-5 bg-stone-950/85 border border-red-900/50 rounded-2xl p-4 shadow-xl">
          <div class="flex items-center justify-between border-b border-red-900/40 pb-3 mb-4">
            <div>
              <span class="text-[10px] font-black uppercase tracking-widest text-red-400">Lado Carmesí • Equipo A</span>
              <h3 id="arenaTeamAName" class="font-epic font-bold text-lg text-white">Equipo A</h3>
            </div>
            <div class="text-right text-xs">
              <span class="text-amber-400 font-bold" id="teamAPicksCount">Picks: 0/3</span> • 
              <span class="text-red-400 font-bold" id="teamABansCount">Bans: 0/2</span>
            </div>
          </div>

          <!-- Pool de 5 cartas del Equipo A -->
          <div id="arenaPoolA" class="space-y-2.5"></div>
        </div>

        <!-- COLUMNA CENTRAL: ANFITRIONES & RESULTADO FINAL (2 cols) -->
        <div class="lg:col-span-2 flex flex-col items-center justify-between gap-4">
          <!-- Comentario dinámico de Odiosa / Nostos -->
          <div class="w-full bg-gradient-to-b from-stone-900 to-black border border-amber-500/30 rounded-2xl p-3.5 text-center shadow-lg">
            <div id="hostAvatar" class="text-3xl mb-1">😈</div>
            <div id="hostName" class="font-epic text-xs font-black text-amber-400 uppercase tracking-wider mb-1">La Odiosa</div>
            <p id="hostQuote" class="text-xs text-stone-300 italic leading-relaxed">
              "Que empiece la carnicería. Sin scroll, sin exo y sin llorar en el chat."
            </p>
          </div>

          <!-- Marcador de Alineación Confirmada -->
          <div class="w-full bg-stone-950/90 border border-stone-800 rounded-2xl p-3 text-center">
            <div class="text-[10px] font-bold uppercase tracking-widest text-stone-400 mb-2">Reglas Activas</div>
            <ul class="text-[11px] text-stone-300 space-y-1 text-left">
              <li>• Lvl 160 estricto</li>
              <li>• Máx. 1 Trofeo Magistral</li>
              <li>• Sin Exo / Over / LUP</li>
              <li>• 10 min / 20 turnos</li>
            </ul>
          </div>
        </div>

        <!-- COLUMNA EQUIPO B (5 cols) -->
        <div class="lg:col-span-5 bg-stone-950/85 border border-amber-800/50 rounded-2xl p-4 shadow-xl">
          <div class="flex items-center justify-between border-b border-amber-800/40 pb-3 mb-4">
            <div>
              <span class="text-[10px] font-black uppercase tracking-widest text-amber-400">Lado Dorado • Equipo B</span>
              <h3 id="arenaTeamBName" class="font-epic font-bold text-lg text-white">Equipo B</h3>
            </div>
            <div class="text-right text-xs">
              <span class="text-amber-400 font-bold" id="teamBPicksCount">Picks: 0/3</span> • 
              <span class="text-red-400 font-bold" id="teamBBansCount">Bans: 0/2</span>
            </div>
          </div>

          <!-- Pool de 5 cartas del Equipo B -->
          <div id="arenaPoolB" class="space-y-2.5"></div>
        </div>

      </div>

      <!-- RESUMEN FINAL DE COMBATE (3v3 DEFINITIVO) -->
      <div id="finalSummaryCard" class="hidden bg-gradient-to-r from-red-950/90 via-stone-950 to-amber-950/90 border-2 border-amber-400 rounded-2xl p-6 shadow-2xl text-center space-y-4">
        <div class="inline-block px-4 py-1 rounded-full bg-amber-500/20 border border-amber-400 text-amber-300 text-xs font-black uppercase tracking-widest">
          ⚔️ Alineaciones Confirmadas para la Arena 3v3 ⚔️
        </div>
        <h3 class="font-epic text-2xl md:text-3xl font-black text-white">¡DRAFT COMPLETADO!</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto pt-2">
          <div class="bg-black/60 border border-red-600/50 rounded-xl p-4">
            <h4 id="summaryTeamAName" class="font-epic font-bold text-red-400 text-lg mb-3">Equipo A</h4>
            <div id="summaryTeamAPicks" class="flex justify-center gap-3"></div>
          </div>
          <div class="bg-black/60 border border-amber-500/50 rounded-xl p-4">
            <h4 id="summaryTeamBName" class="font-epic font-bold text-amber-400 text-lg mb-3">Equipo B</h4>
            <div id="summaryTeamBPicks" class="flex justify-center gap-3"></div>
          </div>
        </div>

        <div class="pt-3 flex justify-center gap-3">
          <button onclick="copyDraftSummary()" class="px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-black font-extrabold text-xs uppercase tracking-wider shadow-lg transition">
            📋 Copiar Resumen para Discord / Chat
          </button>
          <button onclick="resetAll()" class="px-5 py-2.5 rounded-xl bg-stone-800 hover:bg-stone-700 text-white font-bold text-xs uppercase tracking-wider border border-stone-600 transition">
            Siguiente Enfrentamiento
          </button>
        </div>
      </div>

    </section>

  </main>

  <!-- FOOTER -->
  <footer class="border-t border-stone-900 bg-black/80 py-3 px-4 text-center text-xs text-stone-500">
    La Copa Odiosa • Aermyfus Dofus Retro 1.29 • Reglamento Oficial Draft 5-a-3
  </footer>

