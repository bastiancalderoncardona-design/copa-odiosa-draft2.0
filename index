    // 5. RENDERIZADO DE FASE 1 (SELECCIÓN DE POOLS)
    function initSetupGrids() {
      renderSelectorGrid('A');
      renderSelectorGrid('B');
      updateStartButton();
    }

    function renderSelectorGrid(team) {
      const container = document.getElementById(`team${team}SelectorGrid`);
      const selectedIds = team === 'A' ? state.poolA.map(c => c.id) : state.poolB.map(c => c.id);
      
      container.innerHTML = DOFUS_CLASSES.map(cls => {
        const isSelected = selectedIds.includes(cls.id);
        const borderClass = isSelected 
          ? (team === 'A' ? 'border-red-500 bg-red-950/70 ring-2 ring-red-500/60' : 'border-amber-400 bg-amber-950/70 ring-2 ring-amber-400/60')
          : 'border-stone-800 bg-stone-900/60 hover:border-stone-600 opacity-80 hover:opacity-100';

        return `
          <div onclick="togglePoolClass('${team}', '${cls.id}')" 
               class="cursor-pointer rounded-xl border p-2 flex flex-col items-center text-center transition select-none ${borderClass}">
            <div class="w-12 h-12 mb-1">${cls.svg}</div>
            <span class="text-xs font-bold text-white leading-tight">${cls.name}</span>
            <span class="text-[9px] text-stone-400 truncate w-full">${cls.role}</span>
          </div>
        `;
      }).join('');

      document.getElementById(`teamACount`).textContent = `${state.poolA.length} / 5`;
      document.getElementById(`teamBCount`).textContent = `${state.poolB.length} / 5`;
    }

    function togglePoolClass(team, classId) {
      playSound('click');
      const poolKey = team === 'A' ? 'poolA' : 'poolB';
      const existingIndex = state[poolKey].findIndex(item => item.id === classId);

      if (existingIndex > -1) {
        state[poolKey].splice(existingIndex, 1);
      } else {
        if (state[poolKey].length >= 5) return; 
        const clsObj = DOFUS_CLASSES.find(c => c.id === classId);
        state[poolKey].push({ ...clsObj, status: 'available', turnOrder: null });
      }

      renderSelectorGrid(team);
      updateStartButton();
    }

    function updateStartButton() {
      const btn = document.getElementById('startDraftBtn');
      btn.disabled = !(state.poolA.length === 5 && state.poolB.length === 5);
    }

    function randomizePools() {
      playSound('click');
      const shuffle = (arr) => [...arr].sort(() => Math.random() - 0.5);
      state.poolA = shuffle(DOFUS_CLASSES).slice(0, 5).map(c => ({ ...c, status: 'available', turnOrder: null }));
      state.poolB = shuffle(DOFUS_CLASSES).slice(0, 5).map(c => ({ ...c, status: 'available', turnOrder: null }));
      renderSelectorGrid('A');
      renderSelectorGrid('B');
      updateStartButton();
    }

    // 6. INICIO Y EJECUCIÓN DE LA ARENA DE DRAFT (7 TURNOS)
    function startDraft() {
      if (state.poolA.length !== 5 || state.poolB.length !== 5) return;
      playSound('pick');

      state.teamAName = document.getElementById('teamANameInput').value.trim() || 'Equipo A';
      state.teamBName = document.getElementById('teamBNameInput').value.trim() || 'Equipo B';

      state.poolA.forEach(c => { c.status = 'available'; c.turnOrder = null; });
      state.poolB.forEach(c => { c.status = 'available'; c.turnOrder = null; });

      state.currentStepIndex = 0;
      state.actionsRemainingInStep = DRAFT_STEPS[0].count;
      state.draftFinished = false;

      document.getElementById('arenaTeamAName').textContent = state.teamAName;
      document.getElementById('arenaTeamBName').textContent = state.teamBName;

      document.getElementById('setupSection').classList.add('hidden');
      document.getElementById('draftArenaSection').classList.remove('hidden');
      document.getElementById('finalSummaryCard').classList.add('hidden');

      renderArena();
    }

    function backToSetup() {
      playSound('click');
      document.getElementById('draftArenaSection').classList.add('hidden');
      document.getElementById('setupSection').classList.remove('hidden');
    }

    function resetAll() {
      playSound('click');
      state.poolA = [];
      state.poolB = [];
      state.currentStepIndex = 0;
      state.draftFinished = false;
      document.getElementById('draftArenaSection').classList.add('hidden');
      document.getElementById('setupSection').classList.remove('hidden');
      initSetupGrids();
    }

    function handleCardClick(poolOwner, classId) {
      if (state.draftFinished) return;

      const currentStep = DRAFT_STEPS[state.currentStepIndex];
      if (currentStep.action === 'AUTO_PICK') return;
      if (currentStep.targetPool !== poolOwner) return;

      const pool = poolOwner === 'A' ? state.poolA : state.poolB;
      const card = pool.find(c => c.id === classId);
      if (!card || card.status !== 'available') return;

      if (currentStep.action === 'PICK') {
        card.status = 'picked';
        card.turnOrder = `T${currentStep.turn}`;
        playSound('pick');
      } else if (currentStep.action === 'BAN') {
        card.status = 'banned';
        card.turnOrder = `T${currentStep.turn}`;
        playSound('ban');
      }

      if (currentStep.turn === 2 && currentStep.action === 'BAN') {
        const teamAPick1 = state.poolA.find(c => c.status === 'picked');
        if (teamAPick1 && teamAPick1.id === classId) {
          setTimeout(() => {
            document.getElementById('hostAvatar').textContent = '🔥';
            document.getElementById('hostName').textContent = '¡MIRROR BLOQUEADO!';
            document.getElementById('hostQuote').textContent = `"¡Cobardes! El Equipo A vetó su propio ${card.name} en el pool rival para evitar el espejo."`;
          }, 150);
        }
      }

      state.actionsRemainingInStep--;

      if (state.actionsRemainingInStep <= 0) {
        advanceTurn();
      } else {
        renderArena();
      }
    }

    function advanceTurn() {
      state.currentStepIndex++;

      if (state.currentStepIndex >= DRAFT_STEPS.length) {
        finishDraft();
        return;
      }

      const nextStep = DRAFT_STEPS[state.currentStepIndex];
      state.actionsRemainingInStep = nextStep.count;

      if (nextStep.action === 'AUTO_PICK') {
        renderArena();
        setTimeout(() => {
          const targetPool = nextStep.targetPool === 'A' ? state.poolA : state.poolB;
          targetPool.forEach(card => {
            if (card.status === 'available') {
              card.status = 'picked';
              card.turnOrder = `T${nextStep.turn} (Auto)`;
            }
          });
          playSound('pick');
          advanceTurn();
        }, 750);
      } else {
        renderArena();
      }
    }

    function finishDraft() {
      state.draftFinished = true;
      playSound('finish');
      renderArena();

      const summaryCard = document.getElementById('finalSummaryCard');
      summaryCard.classList.remove('hidden');

      document.getElementById('summaryTeamAName').textContent = state.teamAName;
      document.getElementById('summaryTeamBName').textContent = state.teamBName;

      const picksA = state.poolA.filter(c => c.status === 'picked');
