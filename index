      const bansB = state.poolB.filter(c => c.status === 'banned').map(c => c.name).join(', ');

      const text = `⚔️ **LA COPA ODIOSA — RESULTADO DRAFT 5-A-3** ⚔️\n` +
                   `🔴 **${state.teamAName}:** ${picksA} *(Baneados: ${bansA})*\n` +
                   `🟡 **${state.teamBName}:** ${picksB} *(Baneados: ${bansB})*`;

      navigator.clipboard.writeText(text).then(() => {
        alert('¡Resumen copiado al portapapeles! Listo para pegar en Discord o WhatsApp.');
      });
    }

    initSetupGrids();
  </script>
</body>
