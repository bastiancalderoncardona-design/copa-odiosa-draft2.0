        const actorName = currentStep.actor === 'A' ? state.teamAName : state.teamBName;
        const remainingBadge = currentStep.count > 1 && currentStep.action !== 'AUTO_PICK' 
          ? ` (Faltan ${state.actionsRemainingInStep})` 
